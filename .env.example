# cp .env.example .env して利用する
# .env は Git 管理対象外

# --- Compose ---------------------------------------------------------
COMPOSE_PROJECT_NAME=devforge
# 既定で起動するプロファイル（dev / prod）
COMPOSE_PROFILES=dev
TZ=Asia/Tokyo

# --- Frontend --------------------------------------------------------
BUN_VERSION=1
FRONTEND_PORT=3000
FRONTEND_PROD_PORT=3001

# ブラウザから叩く API の URL（ホスト側から見たアドレス）
NEXT_PUBLIC_API_URL=http://localhost:8080
# コンテナ内（Server Components 等）から叩く API の URL（サービス名で解決）
API_URL=http://api:8080

# --- API（将来利用）--------------------------------------------------
API_PORT=8080

# --- MySQL -----------------------------------------------------------
MYSQL_VERSION=8.4
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=root
